# Copy to .env (never commit .env)

# --- Direct providers (existing) ---
OPENAI_API_KEY=
# or
GEMINI_API_KEY=
# or
ANTHROPIC_API_KEY=

# --- Pydantic AI Gateway (prize path) ---
# When set + SKILLSHIFT_USE_GATEWAY=1, Explorer/Verifier/Recovery use Gateway
# so Logfire optimizations can change behaviour without code edits.
# PYDANTIC_AI_GATEWAY_API_KEY=pylf_v2_eu_...
# PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
# SKILLSHIFT_USE_GATEWAY=1
# SKILLSHIFT_GATEWAY_MODEL=gateway/aistudio:models/gemini-3.6-flash
# (or gateway/openai:gpt-4o when the openai route is enabled on your org)

# Force a specific model (beats Gateway default if set):
# SKILLSHIFT_MODEL=gateway/aistudio:models/gemini-3.6-flash
