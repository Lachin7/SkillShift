# Copy to .env (never commit .env)

# --- Direct providers (existing) ---
OPENAI_API_KEY=
# or
GEMINI_API_KEY=
# or
ANTHROPIC_API_KEY=

# --- Pydantic AI Gateway (prize path) ---
# When set, Explorer/Verifier/Recovery use gateway/<provider>:<model>
# so Logfire optimizations can change behaviour without code edits.
# PYDANTIC_AI_GATEWAY_API_KEY=pylf_v_...
# SKILLSHIFT_GATEWAY_MODEL=gateway/openai:gpt-4o

# Force a specific model (beats Gateway default if set):
# SKILLSHIFT_MODEL=gateway/openai:gpt-4o
